<Window x:Class="Lumi.DockingStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumi Workstation" Width="1560" Height="930"
        MinWidth="1250" MinHeight="780" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#020711">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#06111F" BorderBrush="#183E62" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Polygon Points="0,20 10,0 20,20" Stroke="#77CCFF" StrokeThickness="2" Fill="#0B2C4F" Width="20" Height="20" Stretch="Fill"/>
                    <TextBlock Text="Lumi Workstation" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="v0.3.0" Foreground="#9DB4D3" Margin="0,0,18,0"/>
                    <Ellipse Width="9" Height="9" Fill="#49E58E" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TopConnectionText" Text="PHONE: CHECKING" Foreground="#8FE5BA" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" TabStripPlacement="Left" Background="#020711" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabPanel"><Setter Property="Background" Value="#04101D"/></Style>
            </TabControl.Resources>

            <TabItem Header="⌂   Command Deck" Style="{StaticResource NavTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="205"/>
                            <RowDefinition Height="84"/>
                            <RowDefinition Height="208"/>
                            <RowDefinition Height="64"/>
                            <RowDefinition Height="230"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="6" BorderBrush="#174A78" BorderThickness="1">
                            <Border.Background>
                                <RadialGradientBrush Center="0.52,0.55" GradientOrigin="0.52,0.55" RadiusX="0.75" RadiusY="1.0">
                                    <GradientStop Color="#123E78" Offset="0"/>
                                    <GradientStop Color="#071D3A" Offset="0.45"/>
                                    <GradientStop Color="#01050C" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Canvas IsHitTestVisible="False" Opacity="0.45">
                                    <Ellipse Fill="#B7E7FF" Width="2" Height="2" Canvas.Left="80" Canvas.Top="34"/>
                                    <Ellipse Fill="#B7E7FF" Width="2" Height="2" Canvas.Left="210" Canvas.Top="68"/>
                                    <Ellipse Fill="#B7E7FF" Width="3" Height="3" Canvas.Left="390" Canvas.Top="20"/>
                                    <Ellipse Fill="#B7E7FF" Width="2" Height="2" Canvas.Left="880" Canvas.Top="56"/>
                                    <Ellipse Fill="#B7E7FF" Width="2" Height="2" Canvas.Left="1050" Canvas.Top="30"/>
                                </Canvas>
                                <Grid Margin="42,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="L U M I" FontSize="33" FontWeight="Light" Foreground="#EAF7FF"/>
                                        <TextBlock Text="I N T E L L I G E N C E&#x0a;C O M P A N I O N&#x0a;E X P L O R E R&#x0a;A L W A Y S   W I T H   Y O U" FontSize="12" LineHeight="21" Foreground="#C7DEFA" Margin="4,10,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="310" Height="170">
                                        <Polygon Points="155,5 116,52 194,52" Stroke="#C4EEFF" StrokeThickness="2" Fill="#245A9A" Opacity="0.9"/>
                                        <Polygon Points="155,43 88,103 222,103" Stroke="#8FD9FF" StrokeThickness="2" Fill="#174D8C" Opacity="0.78"/>
                                        <Polygon Points="155,85 48,158 262,158" Stroke="#75CFFF" StrokeThickness="2" Fill="#103D75" Opacity="0.7"/>
                                        <Ellipse Width="280" Height="34" VerticalAlignment="Bottom" Fill="#1C7ED6" Opacity="0.18"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="32,0,0,0">
                                        <TextBlock Text="S A M E   M I N D" FontSize="12" Foreground="#A8D9FF"/>
                                        <TextBlock Text="M O R E   P O S S I B I L I T I E S" FontSize="12" Foreground="#6EBBFF" Margin="0,8,0,14"/>
                                        <TextBlock Text="P H O N E&#x0a;W O R K S T A T I O N&#x0a;E M U L A T O R&#x0a;T O G E T H E R" FontSize="11" LineHeight="20" Foreground="#C8DEFA"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="RefreshPhone_Click" Margin="0,0,8,0"><StackPanel><TextBlock Text="▣  Check Phone" FontSize="15"/><TextBlock Text="Detect and verify Lumi phone" Foreground="#9DB4D3" FontSize="11" Margin="0,5,0,0"/></StackPanel></Button>
                            <Button Grid.Column="1" Click="Build_Click" Margin="0,0,8,0"><StackPanel><TextBlock Text="⚒  Build" FontSize="15"/><TextBlock Text="Build Lumi from source" Foreground="#9DB4D3" FontSize="11" Margin="0,5,0,0"/></StackPanel></Button>
                            <Button Grid.Column="2" Click="Deploy_Click" Margin="0,0,8,0"><StackPanel><TextBlock Text="↗  Install" FontSize="15"/><TextBlock Text="Deploy to phone" Foreground="#9DB4D3" FontSize="11" Margin="0,5,0,0"/></StackPanel></Button>
                            <Button Grid.Column="3" Click="Diagnostics_Click" Margin="0,0,8,0"><StackPanel><TextBlock Text="⌁  Run Diagnostics" FontSize="15"/><TextBlock Text="Collect logs and system data" Foreground="#9DB4D3" FontSize="11" Margin="0,5,0,0"/></StackPanel></Button>
                            <Button Grid.Column="4" Click="OpenAndroidStudio_Click"><StackPanel><TextBlock Text="◉  Open Android Studio" FontSize="15"/><TextBlock Text="Launch project" Foreground="#9DB4D3" FontSize="11" Margin="0,5,0,0"/></StackPanel></Button>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="PROJECT STATUS" FontSize="14" Foreground="#CFEAFF"/>
                                    <Separator Background="#183E62" Margin="0,9"/>
                                    <TextBlock Text="●   Canonical Source        Protected" Foreground="#49E58E" Margin="0,6"/>
                                    <TextBlock Text="●   Live Source (Working)   Workstation clone" Foreground="#49E58E" Margin="0,6"/>
                                    <TextBlock Text="●   Build Status            Ready" Foreground="#49E58E" Margin="0,6"/>
                                    <TextBlock Text="●   Tests                   Pending next build" Foreground="#9DB4D3" Margin="0,6"/>
                                    <TextBlock Text="●   Provider Vault          Windows encrypted" Foreground="#49E58E" Margin="0,6"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="LUMI RELEASE" FontSize="14" Foreground="#CFEAFF"/>
                                    <Separator Background="#183E62" Margin="0,9"/>
                                    <TextBlock Text="Current on Phone" Foreground="#9DB4D3"/>
                                    <TextBlock x:Name="ReleasePhoneText" Text="Detecting..." FontSize="18" Margin="0,4,0,12"/>
                                    <TextBlock Text="Latest Workstation" Foreground="#9DB4D3"/>
                                    <TextBlock Text="Dock 0.3.0" Foreground="#8FCBFF" FontSize="17" Margin="0,4,0,12"/>
                                    <Button Content="Open Workspace" Click="OpenWorkspace_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="PHONE DOCK" FontSize="14" Foreground="#CFEAFF"/><Ellipse Width="9" Height="9" Fill="#49E58E" Margin="14,4,7,0"/><TextBlock x:Name="PhoneStateText" Text="Checking..." Foreground="#49E58E"/></StackPanel>
                                    <Separator Background="#183E62" Margin="0,9"/>
                                    <TextBlock x:Name="PhoneDetailText" Text="No device information yet." Foreground="#B5CAE5" TextWrapping="Wrap" LineHeight="20"/>
                                    <WrapPanel Margin="0,12,0,0"><Button Content="Refresh" Click="RefreshPhone_Click"/><Button Content="Open Lumi" Click="OpenLumi_Click"/></WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="CommandInputBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center" Padding="12,8" KeyDown="CommandInput_KeyDown" ToolTip="Enter sends. Shift+Enter adds a new line."/>
                            <Button x:Name="SendCommandButton" Grid.Column="1" Content="SEND TO LUMI" Click="SendCommand_Click" Margin="10,0,0,0" Padding="22,8"/>
                        </Grid>

                        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="ACTIVITY LOG / COMMAND CONSOLE" FontSize="13" Foreground="#CFEAFF"/><TextBlock Text="type 'help' for local commands" HorizontalAlignment="Right" Foreground="#6F92B8"/></Grid>
                                <TextBox x:Name="CommandTranscriptBox" Grid.Row="1" Margin="0,9,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="10" BorderBrush="#123A5D" Text="Lumi Workstation 0.3.0 online.&#x0a;Type 'help' for commands.&#x0a;"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="▯   Phone Dock" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PHONE DOCK" FontSize="28"/><Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Connected Android device" FontSize="18"/><TextBlock Text="Use Command Deck > Check Phone for live device and Lumi details." Foreground="#9DB4D3" Margin="0,8,0,16"/><WrapPanel><Button Content="Refresh Phone" Click="RefreshPhone_Click"/><Button Content="Open Lumi" Click="OpenLumi_Click"/><Button Content="Capture Diagnostics" Click="Diagnostics_Click"/></WrapPanel></StackPanel></Border></Grid>
            </TabItem>

            <TabItem Header="&lt;/&gt;  Source &amp; Build" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><StackPanel><TextBlock Text="SOURCE &amp; BUILD" FontSize="28"/><TextBlock Text="Canonical source stays protected. Work from the live workstation clone." Foreground="#9DB4D3" Margin="0,8,0,20"/><WrapPanel><Button Content="Open Workspace" Click="OpenWorkspace_Click"/><Button Content="Build" Click="Build_Click"/><Button Content="Open Android Studio" Click="OpenAndroidStudio_Click"/></WrapPanel></StackPanel></Grid>
            </TabItem>

            <TabItem Header="↗   Install &amp; Deploy" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><StackPanel><TextBlock Text="INSTALL &amp; DEPLOY" FontSize="28"/><TextBlock Text="Replace-in-place deployment only. Lumi is never uninstalled to force a build." Foreground="#9DB4D3" Margin="0,8,0,20"/><Button Content="Build + Install to Phone" Click="Deploy_Click" HorizontalAlignment="Left" Padding="24,10"/></StackPanel></Grid>
            </TabItem>

            <TabItem Header="⌁   Diagnostics" Style="{StaticResource NavTabStyle}">
                <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="DIAGNOSTICS" FontSize="26"/><Button Content="Capture Phone Diagnostics" Click="Diagnostics_Click" HorizontalAlignment="Right"/></Grid><TextBox x:Name="DiagnosticsBox" Grid.Row="1" Margin="0,16,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="12" Text="Docking Station initialized.&#x0a;"/></Grid>
            </TabItem>

            <TabItem Header="▣   Emulator" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><StackPanel><TextBlock Text="EMULATOR" FontSize="28"/><TextBlock Text="Android Studio manages local virtual devices. Open the project and Device Manager from here." Foreground="#9DB4D3" Margin="0,8,0,20"/><Button Content="Open Android Studio" Click="OpenAndroidStudio_Click" HorizontalAlignment="Left"/></StackPanel></Grid>
            </TabItem>

            <TabItem Header="☾   Night Watch" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><StackPanel><TextBlock Text="NIGHT WATCH" FontSize="28"/><TextBlock Text="Workstation development can continue while the phone is disconnected. Deployment waits for phone validation." Foreground="#9DB4D3" Margin="0,8,0,20"/></StackPanel></Grid>
            </TabItem>

            <TabItem Header="▰   Releases &amp; History" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><StackPanel><TextBlock Text="RELEASES &amp; HISTORY" FontSize="28"/><TextBlock Text="Build, deployment and instruction evidence remains in Documents\Lumi Workstation." Foreground="#9DB4D3" Margin="0,8,0,20"/><Button Content="Open Workspace" Click="OpenWorkspace_Click" HorizontalAlignment="Left"/></StackPanel></Grid>
            </TabItem>

            <TabItem Header="✦   AI Vault" Style="{StaticResource NavTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI PROVIDER VAULT" FontSize="28"/>
                            <TextBlock Text="Add as many provider connections and API keys as you need. Secrets are encrypted to this Windows account with DPAPI." Foreground="#9DB4D3" Margin="0,7,0,18"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Provider preset" VerticalAlignment="Center"/><ComboBox x:Name="ProviderTypeBox" Grid.Column="1" SelectionChanged="ProviderType_Changed"><ComboBoxItem Content="OpenAI" IsSelected="True"/><ComboBoxItem Content="OpenRouter"/><ComboBoxItem Content="Groq"/><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="Anthropic"/><ComboBoxItem Content="Mistral"/><ComboBoxItem Content="Cerebras"/><ComboBoxItem Content="Custom OpenAI-Compatible"/></ComboBox>
                                <TextBlock Grid.Column="2" Text="Connection name" VerticalAlignment="Center" Margin="18,0,0,0"/><TextBox x:Name="ProviderNameBox" Grid.Column="3" Padding="8" Text="OpenAI Primary"/>
                                <TextBlock Grid.Row="1" Text="Endpoint" VerticalAlignment="Center" Margin="0,12,0,0"/><TextBox x:Name="ProviderEndpointBox" Grid.Row="1" Grid.Column="1" Padding="8" Margin="0,12,0,0" Text="https://api.openai.com/v1/responses"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Model" VerticalAlignment="Center" Margin="18,12,0,0"/><TextBox x:Name="ProviderModelBox" Grid.Row="1" Grid.Column="3" Padding="8" Margin="0,12,0,0" Text="gpt-5.6-luna"/>
                                <TextBlock Grid.Row="2" Text="API key" VerticalAlignment="Center" Margin="0,12,0,0"/><PasswordBox x:Name="ProviderKeyBox" Grid.Row="2" Grid.Column="1" Padding="8" Margin="0,12,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="18,12,0,0"><CheckBox x:Name="ProviderEnabledBox" Content="Enabled" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="ADD CONNECTION" Click="AddProvider_Click"/><Button Content="TEST SELECTED" Click="TestProvider_Click"/><Button Content="REMOVE SELECTED" Click="RemoveProvider_Click"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,14,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="SAVED AI CONNECTIONS" FontSize="14"/><TextBlock x:Name="ProviderCountText" Text="0 configured" HorizontalAlignment="Right" Foreground="#8FCBFF"/></Grid><ListBox x:Name="ProviderConnectionsList" Grid.Row="1" Margin="0,10,0,0" MinHeight="310" Padding="6"/></Grid>
                        </Border>
                        <PasswordBox x:Name="GroqKeyBox" Visibility="Collapsed"/><PasswordBox x:Name="OpenRouterKeyBox" Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚙   Settings" Style="{StaticResource NavTabStyle}">
                <Grid Margin="24"><StackPanel><TextBlock Text="SETTINGS" FontSize="28"/><TextBlock Text="Workstation settings, provider routing and device preferences will live here." Foreground="#9DB4D3" Margin="0,8,0,20"/></StackPanel></Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#04101D" BorderBrush="#183E62" BorderThickness="0,1,0,0">
            <Grid Margin="14,0"><TextBlock x:Name="StatusText" Text="Starting..." Foreground="#8FE5BA" VerticalAlignment="Center"/><TextBlock Text="EXPLORE  •  LEARN  •  IMPROVE  •  BELONG" HorizontalAlignment="Right" Foreground="#617E9F" VerticalAlignment="Center" FontSize="10"/></Grid>
        </Border>
    </Grid>
</Window>