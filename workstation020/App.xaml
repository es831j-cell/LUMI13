<Application x:Class="Lumi.DockingStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171B22" />
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB3C0" />
        <Style TargetType="Window">
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263241"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B4A5E"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0D11"/>
            <Setter Property="Foreground" Value="#E8EDF3"/>
            <Setter Property="BorderBrush" Value="#364150"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0A0D11"/>
            <Setter Property="Foreground" Value="#E8EDF3"/>
            <Setter Property="BorderBrush" Value="#364150"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="BorderBrush" Value="#29313D"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#161B22"/>
        </Style>
    </Application.Resources>
</Application>
