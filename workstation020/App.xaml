<Application x:Class="Lumi.DockingStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#07111E" />
        <SolidColorBrush x:Key="PanelBrush2" Color="#0A1726" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9DB4D3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#67B7FF" />
        <SolidColorBrush x:Key="CyanBrush" Color="#76D7FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#49E58E" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="#020711"/>
            <Setter Property="Foreground" Value="#F5FAFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0B1C30"/>
            <Setter Property="Foreground" Value="#EAF5FF"/>
            <Setter Property="BorderBrush" Value="#245A8A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#10345A"/><Setter TargetName="b" Property="BorderBrush" Value="#5DB9FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#0A2543"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#020812"/>
            <Setter Property="Foreground" Value="#EAF5FF"/>
            <Setter Property="BorderBrush" Value="#234E77"/>
            <Setter Property="CaretBrush" Value="#8AD5FF"/>
            <Setter Property="SelectionBrush" Value="#245A8A"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#020812"/>
            <Setter Property="Foreground" Value="#EAF5FF"/>
            <Setter Property="BorderBrush" Value="#234E77"/>
            <Setter Property="CaretBrush" Value="#8AD5FF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#081727"/>
            <Setter Property="Foreground" Value="#EAF5FF"/>
            <Setter Property="BorderBrush" Value="#234E77"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#020812"/>
            <Setter Property="Foreground" Value="#DDEEFF"/>
            <Setter Property="BorderBrush" Value="#234E77"/>
        </Style>

        <Style x:Key="NavTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#C5D8EF"/>
            <Setter Property="Background" Value="#04101D"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="228"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="nav" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="nav" Property="Background" Value="#0A2A4B"/><Setter TargetName="nav" Property="BorderBrush" Value="#73C7FF"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="nav" Property="Background" Value="#081D33"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#07111E"/>
            <Setter Property="BorderBrush" Value="#183E62"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
    </Application.Resources>
</Application>